+                "running_output_lens": [len(r.output_ids) for r in running_batch.reqs],
+                "decoding_rids": [
+                    r.rid for r in (running_batch.decoding_reqs or [])
+                ],
                 "queued_rids": [r.rid for r in waiting_queue],
+                "queued_origin_input_lens": [len(r.origin_input_ids) for r in waiting_queue],
+                "queued_output_lens": [len(r.output_ids) for r in waiting_queue],
             },
         )
