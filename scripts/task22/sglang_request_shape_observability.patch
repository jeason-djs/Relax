@@ -49,7 +49,18 @@ class SchedulerStatusLogger:
             "scheduler.status",
             {
                 "rank": self.rank,
+                "forward_mode": str(running_batch.forward_mode),
                 "running_rids": [r.rid for r in running_batch.reqs],
+                "running_seq_lens": [int(r.seqlen) for r in running_batch.reqs],
+                "running_origin_input_lens": [
+                    len(r.origin_input_ids) for r in running_batch.reqs
